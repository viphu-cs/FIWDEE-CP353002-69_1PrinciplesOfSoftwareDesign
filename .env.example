# ===================================================================
# FIWDEE Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ===================================================================

# Database Settings
POSTGRES_DB=fiwdee_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# เปลี่ยนถ้าพอร์ต 5432 บนเครื่องถูกใช้โดย Postgres local อยู่แล้ว (เช่น 5434)
POSTGRES_PORT=5432

# Backend Settings
BACKEND_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Frontend Settings
FRONTEND_PORT=3000
