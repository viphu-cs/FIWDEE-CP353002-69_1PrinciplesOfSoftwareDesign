{
  "info": {
    "_postman_id": "fiwdee-dev3-booking-collection-2026",
    "name": "FIWDEE - Dev 3 (Booking Engine & State Pattern)",
    "description": "Postman Collection for testing Core Booking Engine, Availability with 15-min cleaning buffer, GoF State Pattern lifecycle, and Admin booking overview.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "staff_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "booking_id",
      "value": "7",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login as Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('customer_token', jsonData.data.token);",
                  "    console.log('Customer token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"customer@test.com\",\n  \"password\": \"customer1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as test customer and automatically sets `customer_token` collection variable."
          }
        },
        {
          "name": "1.2 Login as Receptionist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('staff_token', jsonData.data.token);",
                  "    console.log('Staff token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"reception@fiwdee-massage.co.th\",\n  \"password\": \"recep1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in as receptionist (staff) and automatically sets `staff_token` collection variable."
          }
        }
      ]
    },
    {
      "name": "2. Availability Engine (UC-08)",
      "item": [
        {
          "name": "2.1 Check Available Slots (with 15-min Buffer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings/availability?serviceId=2&date=2026-10-16&durationMinutes=60",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "availability"],
              "query": [
                {
                  "key": "serviceId",
                  "value": "2",
                  "description": "Service ID (e.g. 2 for Aroma Massage)"
                },
                {
                  "key": "date",
                  "value": "2026-10-16",
                  "description": "Date in YYYY-MM-DD format (Friday is open)"
                },
                {
                  "key": "durationMinutes",
                  "value": "60",
                  "description": "Duration in minutes"
                }
              ]
            },
            "description": "Public endpoint to calculate available time slots, therapists with matching skills, and rooms with 15-minute cleaning buffer."
          }
        },
        {
          "name": "2.2 Check Closed Day (Thursday - returns empty slots)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings/availability?serviceId=2&date=2026-10-15&durationMinutes=60",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "availability"],
              "query": [
                {
                  "key": "serviceId",
                  "value": "2"
                },
                {
                  "key": "date",
                  "value": "2026-10-15",
                  "description": "Thursday is marked as closed in Shop business hours"
                },
                {
                  "key": "durationMinutes",
                  "value": "60"
                }
              ]
            },
            "description": "Demonstrates operating hours check: returns empty availableSlots when shop is closed."
          }
        }
      ]
    },
    {
      "name": "3. Booking Engine (UC-07, UC-09, UC-10)",
      "item": [
        {
          "name": "3.1 Create Booking (Customer - Auto Allocate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('booking_id', jsonData.data.id);",
                  "    console.log('Created booking ID: ' + jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": 2,\n  \"durationOptionId\": 4,\n  \"startDateTime\": \"2026-10-16T15:00:00\",\n  \"bookingChannel\": \"ONLINE\",\n  \"specialNotes\": \"เน้นคอบ่าไหล่เป็นพิเศษ\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings"]
            },
            "description": "Creates a new booking without specifying therapist or room. The system automatically allocates an available eligible therapist and suitable room."
          }
        },
        {
          "name": "3.2 Get Booking Detail by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookings/{{booking_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "{{booking_id}}"]
            },
            "description": "Retrieves booking details. Ownership validation is enforced (customer can only see their own)."
          }
        },
        {
          "name": "3.3 Get My Bookings (Customer History)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookings/my",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "my"]
            },
            "description": "Returns list of bookings for the authenticated customer ordered newest first."
          }
        },
        {
          "name": "3.4 Cancel Booking (Customer >= 2 hours)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"ติดประชุมด่วน ขอเลื่อนการรับบริการ\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings/{{booking_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "{{booking_id}}", "cancel"]
            },
            "description": "Cancels booking through State Pattern (PENDING/CONFIRMED -> CANCELLED). Enforces 2-hour customer rule."
          }
        },
        {
          "name": "3.5 Test Invalid Transition (Cancel Already Cancelled)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"ยกเลิกซ้ำ\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings/{{booking_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "{{booking_id}}", "cancel"]
            },
            "description": "Tests GoF State Pattern guard: trying to cancel a booking in CANCELLED terminal state returns 400 Bad Request error."
          }
        }
      ]
    },
    {
      "name": "4. Staff Operations & Back-Office",
      "item": [
        {
          "name": "4.1 Admin View Daily Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/bookings?date=2026-10-16",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "bookings"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-10-16"
                }
              ]
            },
            "description": "Receptionist/Owner endpoint to view all bookings for a given date."
          }
        },
        {
          "name": "4.2 Staff Update Booking Status (State Pattern)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookings/{{booking_id}}/status?status=CONFIRMED",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "{{booking_id}}", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "CONFIRMED",
                  "description": "Target status: CONFIRMED, CHECKED_IN, IN_SERVICE, COMPLETED, CANCELLED, NO_SHOW"
                }
              ]
            },
            "description": "Allows staff to transition booking states according to the GoF State Pattern."
          }
        }
      ]
    }
  ]
}
