# ===== docker-compose environment =====
# Copy this file to .env and adjust values as needed.
# .env is git-ignored - never commit real credentials.

# Postgres
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Host ports
# Host port for reaching Postgres from host tools (container-internal is always 5432)
DB_PORT=5434

BACKEND_PORT=8080
FRONTEND_PORT=8081
